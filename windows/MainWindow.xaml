<Window x:Class="ZXPManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ZXPManager"
        Title="ZXP Manager"
        Icon="AppIcon.ico"
        Width="680" Height="540" MinWidth="560" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource Fg}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="130" />
    </Grid.RowDefinitions>

    <!-- Toolbar -->
    <DockPanel Grid.Row="0" Margin="10,6" LastChildFill="False">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <ProgressBar x:Name="BusyBar" Width="80" Height="4" Margin="0,0,10,0" IsIndeterminate="True"
                     VerticalAlignment="Center" Visibility="Collapsed" BorderThickness="0"
                     Background="Transparent" Foreground="{DynamicResource Accent}" />
        <Button x:Name="AddButton" Style="{StaticResource ToolButton}" Click="Add_Click"
                ToolTip="{local:Tr toolbar.install}" AutomationProperties.Name="{local:Tr toolbar.install}">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" />
        </Button>
        <Button x:Name="RemoveButton" Style="{StaticResource ToolButton}" Click="Remove_Click" IsEnabled="False"
                ToolTip="{local:Tr toolbar.remove}" AutomationProperties.Name="{local:Tr toolbar.remove}">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" />
        </Button>
        <Button x:Name="RefreshButton" Style="{StaticResource ToolButton}" Click="Refresh_Click"
                ToolTip="{local:Tr toolbar.refresh}" AutomationProperties.Name="{local:Tr toolbar.refresh}">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" />
        </Button>
        <ToggleButton x:Name="EmptyToggle" Style="{StaticResource ToolToggle}" Click="EmptyToggle_Click">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE890;" />
        </ToggleButton>
      </StackPanel>
    </DockPanel>
    <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource BorderBrush}" />

    <!-- List + drop area -->
    <Grid x:Name="DropArea" Grid.Row="1" AllowDrop="True" Background="Transparent"
          DragEnter="DropArea_DragOver" DragOver="DropArea_DragOver"
          DragLeave="DropArea_DragLeave" Drop="DropArea_Drop">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <ListBox x:Name="ExtensionList" Grid.Row="0"
               Style="{StaticResource ExtensionListBox}"
               ItemContainerStyle="{StaticResource ExtensionItemStyle}"
               SelectionMode="Single"
               IsSynchronizedWithCurrentItem="False"
               SelectionChanged="ExtensionList_SelectionChanged"
               KeyDown="ExtensionList_KeyDown">
        <ListBox.GroupStyle>
          <GroupStyle>
            <GroupStyle.HeaderTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}" Margin="14,12,0,4" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource FgSecondary}" />
              </DataTemplate>
            </GroupStyle.HeaderTemplate>
          </GroupStyle>
        </ListBox.GroupStyle>
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type local:ExtensionItem}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="StatusGlyph" Grid.Column="0" Style="{StaticResource Glyph}" FontSize="15"
                         Margin="0,0,10,0" Text="&#xEC61;" Foreground="{DynamicResource Success}" />
              <TextBlock x:Name="NameText" Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="VersionText" Grid.Column="2" Text="{Binding Version}" Margin="12,0,0,0"
                         VerticalAlignment="Center" Foreground="{DynamicResource FgSecondary}" />
            </Grid>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding Enabled}" Value="False">
                <Setter TargetName="StatusGlyph" Property="Text" Value="&#xE769;" />
                <Setter TargetName="StatusGlyph" Property="Foreground" Value="{DynamicResource FgSecondary}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                <Setter TargetName="StatusGlyph" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="VersionText" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource FgSecondary}" />
                <Setter TargetName="NameText" Property="FontStyle" Value="Italic" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Shown when there is nothing to list -->
      <StackPanel x:Name="EmptyState" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                  IsHitTestVisible="False" Visibility="Collapsed">
        <TextBlock Style="{StaticResource Glyph}" Text="&#xEA86;" FontSize="40" Margin="0,0,0,10"
                   Foreground="{DynamicResource FgSecondary}" />
        <TextBlock Text="{local:Tr list.empty.title}" HorizontalAlignment="Center" FontSize="14" />
        <TextBlock Text="{local:Tr list.empty.hint}" HorizontalAlignment="Center" Margin="0,4,0,0"
                   Foreground="{DynamicResource FgSecondary}" />
      </StackPanel>

      <!-- Always-visible hint: files can be dropped here (click = file picker) -->
      <Grid x:Name="DropHint" Grid.Row="1" Margin="12,6,12,10" Height="40" Cursor="Hand"
            Background="Transparent" MouseLeftButtonUp="DropHint_Click"
            ToolTip="{local:Tr toolbar.install}" ToolTipService.InitialShowDelay="500">
        <Rectangle RadiusX="8" RadiusY="8" Stroke="{DynamicResource FgSecondary}" StrokeThickness="1.5"
                   StrokeDashArray="4 3" Opacity="0.55" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="14" Margin="0,0,8,0"
                     Foreground="{DynamicResource FgSecondary}" />
          <TextBlock Text="{local:Tr list.empty.hint}" Foreground="{DynamicResource FgSecondary}"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>

      <!-- Feedback while a file is dragged over the window -->
      <Grid x:Name="DropOverlay" Grid.RowSpan="2" Margin="8" IsHitTestVisible="False" Visibility="Collapsed">
        <Border CornerRadius="12" Background="{DynamicResource Accent}" Opacity="0.12" />
        <Rectangle RadiusX="12" RadiusY="12" Stroke="{DynamicResource Accent}" StrokeThickness="3"
                   StrokeDashArray="3 2" />
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="44" Margin="0,0,0,10"
                     Foreground="{DynamicResource Accent}" />
          <TextBlock Text="{local:Tr drop.release}" FontSize="18" FontWeight="SemiBold"
                     HorizontalAlignment="Center" Foreground="{DynamicResource Accent}" />
        </StackPanel>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Height="1" Background="{DynamicResource BorderBrush}" />

    <!-- Details panel -->
    <Grid Grid.Row="3" Background="{DynamicResource PanelBg}">
      <TextBox x:Name="LogBox" IsReadOnly="True" BorderThickness="0" Background="Transparent"
               Foreground="{DynamicResource Fg}" CaretBrush="{DynamicResource Fg}"
               FontFamily="Consolas" FontSize="11.5" Padding="8,6"
               TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
      <TextBlock x:Name="LogPlaceholder" Text="{local:Tr log.placeholder}" Margin="12,8"
                 FontFamily="Consolas" FontSize="11.5" IsHitTestVisible="False"
                 Foreground="{DynamicResource FgSecondary}" TextWrapping="Wrap" />
    </Grid>
  </Grid>
</Window>
