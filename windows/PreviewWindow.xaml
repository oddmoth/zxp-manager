<Window x:Class="ZXPManager.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ZXPManager"
        Title="ZXP Manager"
        Width="540" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource Fg}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Grid Margin="22,20,22,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,16" />

    <ScrollViewer Grid.Row="1" MaxHeight="420" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="Cards" />
    </ScrollViewer>

    <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
      <StackPanel x:Name="ProgressPanel" DockPanel.Dock="Left" Orientation="Horizontal" Visibility="Collapsed">
        <ProgressBar Width="60" Height="4" IsIndeterminate="True" VerticalAlignment="Center" BorderThickness="0"
                     Background="Transparent" Foreground="{DynamicResource Accent}" />
        <TextBlock Text="{local:Tr preview.progress}" Margin="10,0,0,0" VerticalAlignment="Center"
                   Foreground="{DynamicResource FgSecondary}" />
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="CancelButton" Style="{StaticResource DialogButton}" Content="{local:Tr button.cancel}"
                IsCancel="True" Margin="0,0,8,0" />
        <Button x:Name="InstallButton" Style="{StaticResource PrimaryButton}" Content="{local:Tr button.install}"
                IsDefault="True" Click="Install_Click" />
        <Button x:Name="CloseButton" Style="{StaticResource PrimaryButton}" Content="{local:Tr button.close}"
                Visibility="Collapsed" Click="Close_Click" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
